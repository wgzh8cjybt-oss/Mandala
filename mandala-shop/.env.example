# ===== Обязательные секреты (НЕ коммитьте реальный .env в git) =====
# Токен бота от @BotFather. Хранится только здесь, в клиентский код не попадает.
BOT_TOKEN=123456789:replace_with_real_token
# Имя бота без @ (для ссылок и сообщений)
BOT_USERNAME=your_bot
# Случайная строка 32-256 символов из A-Z a-z 0-9 _ - (Telegram будет присылать её в заголовке
# X-Telegram-Bot-Api-Secret-Token; сервер отклоняет запросы без неё). Сгенерировать: openssl rand -hex 32
WEBHOOK_SECRET=
# Дополнительно: секретная часть пути вебхука (необязательно, но желательно). Сгенерировать: openssl rand -hex 16
WEBHOOK_PATH=
# Публичный HTTPS-адрес сервера без слэша в конце (по нему Telegram шлёт обновления и открывается Mini App)
PUBLIC_URL=https://shop.example.com
# Telegram ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=123456789
# Необязательно: вход в админку из обычного браузера (минимум 32 символа). Пусто = отключено.
ADMIN_TOKEN=

# ===== Параметры =====
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
# Контакт поддержки по платежам (показывается по /paysupport и /support), например @your_support или mail
SUPPORT_CONTACT=@your_support
# Версия условий покупки; при изменении текста увеличьте, пользователи подтвердят заново
TERMS_VERSION=1
# Максимальный возраст initData Mini App в секундах (86400 = сутки, рекомендация Telegram)
INITDATA_MAX_AGE_SEC=86400
# Сколько секунд заказ можно оплатить после создания
ORDER_TTL_SEC=3600
# Максимум слотов мандал на пользователя (включая бесплатный первый)
MAX_SLOTS=10
# Ориентировочный денежный эквивалент 1 Star в USD (для отчётов; НЕ гарантия выплаты, проверяйте актуальный курс)
STAR_USD_ESTIMATE=0.013
# Часовой пояс отчётов
STATS_TZ=Europe/Kiev
# Резервные копии базы: каждые N часов, хранить K последних
BACKUP_EVERY_HOURS=6
BACKUP_KEEP=28
# Сверка платежей с Telegram (getStarTransactions): каждые N часов, 0 = выключено
RECONCILE_EVERY_HOURS=24
# Разрешённые источники для CORS через запятую (нужно, только если приложение лежит на другом домене)
CORS_ORIGINS=
# 1, если сервер стоит за reverse proxy (Caddy/nginx) и IP берётся из X-Forwarded-For
TRUST_PROXY=1
# Только для тестов/песочницы: адрес Bot API (по умолчанию официальный)
TELEGRAM_API_BASE=https://api.telegram.org

# ===== Дополнительно (необязательно) =====
# 1 = при запуске сервер сам зарегистрирует вебхук, команды бота и кнопку меню (иначе: npm run webhook:set)
AUTO_SET_WEBHOOK=0
# Уровень журнала: debug | info | warn | error
LOG_LEVEL=info
# Путь к файлу клиента (Mini App), если он лежит не в public/index.html
CLIENT_FILE=

# ===== Напоминания «Возвращение к своему пути» (отправляет только сервер через бота) =====
# 0 = полностью отключить планировщик напоминаний
REMINDERS_ENABLED=1
# Как часто планировщик проверяет, кому пора написать (секунды, 10-3600)
REMINDERS_TICK_SEC=60
# Пауза между отправками, мс (лимит Telegram ≈ 30 сообщений в секунду)
REMIND_GAP_MS=40
# Максимум сообщений за один проход
REMIND_MAX_PER_TICK=300
